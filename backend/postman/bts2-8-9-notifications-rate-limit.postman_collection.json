    {
      "name": "Rate limit (BTS2-9, NFR-2)",
      "description": "Run this folder last: once the limit is reached, every write from this IP gets 429 for the rest of the minute. Earlier write requests in the run also count toward the 60, so the loop stops as soon as the 429 arrives rather than at a fixed request number.",
      "item": [
        {
          "name": "NFR-2 (429): writes until the limit is reached",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.variables.get('rlCount') || 0) + 1;",
                  "pm.variables.set('rlCount', n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.variables.get('rlCount'));",
                  "const instances = Number(pm.environment.get('instances') || 1);",
                  "const max = 60 * instances + 5;",
                  "",
                  "if (pm.response.code === 401) {",
                  "  // Still under the limit: auth rejected it, so the limiter let it through.",
                  "  pm.test('write #' + n + ' is under the limit (401 from auth, not 429)', function () {",
                  "    pm.response.to.have.status(401);",
                  "  });",
                  "  if (n === 1) {",
                  "    pm.test('policy header says 60 per minute', function () {",
                  "      pm.expect(pm.response.headers.get('RateLimit-Policy')).to.include('60-in-1min');",
                  "    });",
                  "  }",
                  "  if (n < max) {",
                  "    pm.execution.setNextRequest(pm.info.requestName);",
                  "  } else {",
                  "    pm.test('limit reached within ' + max + ' writes', function () { pm.expect.fail('no 429 after ' + n + ' writes'); });",
                  "  }",
                  "} else {",
                  "  pm.variables.set('rlCount', 0);",
                  "  pm.test('write #' + n + ' in this burst is rejected with 429', function () {",
                  "    pm.response.to.have.status(429);",
                  "  });",
                  "  pm.test('429 body uses the agreed message', function () {",
                  "    pm.expect(pm.response.json()).to.eql({ success: false, errors: ['Too many requests, please try again in a minute.'] });",
                  "  });",
                  "  pm.test('no more than 60 writes per instance were allowed', function () {",
                  "    pm.expect(n - 1).to.be.at.most(60 * instances);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
