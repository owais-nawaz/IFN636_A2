    {
      "name": "Export",
      "item": [
        {
          "name": "FR-3 AC2: QA Lead exports CSV",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const HEADER = 'ticketId,title,module,severity,priority,status,reporter,assignee,'",
                  "  + 'resolutionType,resolutionNotes,qaNotes,createdAt,updatedAt,resolvedAt';",
                  "",
                  "pm.test('status is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Content-Type contains text/csv', function () {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('text/csv');",
                  "});",
                  "",
                  "pm.test('Content-Disposition is an attachment with a filename', function () {",
                  "  const disposition = pm.response.headers.get('Content-Disposition');",
                  "  pm.expect(disposition).to.include('attachment');",
                  "  pm.expect(disposition).to.match(/filename=\"bugs-report-\\d{4}-\\d{2}-\\d{2}\\.csv\"/);",
                  "});",
                  "",
                  "pm.test('first line is the header row', function () {",
                  "  pm.expect(pm.response.text().split(/\\r?\\n/)[0]).to.equal(HEADER);",
                  "});",
                  "",
                  "pm.test('body has no _id', function () {",
                  "  pm.expect(pm.response.text()).to.not.include('_id');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "bearer",
              "bearer": [{ "key": "token", "value": "{{qaToken}}", "type": "string" }]
            },
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reports/export?format=csv",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reports", "export"],
              "query": [{ "key": "format", "value": "csv" }]
            }
          },
          "response": []
        },
