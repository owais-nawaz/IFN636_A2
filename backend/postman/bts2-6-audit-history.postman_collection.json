    {
      "name": "02 Audit FR-1/NFR-1 (Saroj)",
      "description": "Requests for GET /api/bugs/:id/history (BTS2-6, FR-1 / NFR-1): success (200 with oldest-first order and role access for Tester, Developer, QA Lead), 401 without token or invalid token, and 404 for non-existent or non-numeric IDs.",
      "item": [
        {
          "name": "FR-1 (200): get history as Tester (success, oldest first)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"returns 200 OK\", function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"response indicates success and returns history array\", function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.success).to.be.true;",
                  "  pm.expect(res.count).to.be.a(\"number\");",
                  "  pm.expect(res.history).to.be.an(\"array\");",
                  "});",
                  "",
                  "pm.test(\"history entries have required fields\", function () {",
                  "  const history = pm.response.json().history;",
                  "  if (history.length > 0) {",
                  "    const entry = history[0];",
                  "    pm.expect(entry).to.have.property(\"bugId\");",
                  "    pm.expect(entry).to.have.property(\"action\");",
                  "    pm.expect(entry).to.have.property(\"timestamp\");",
                  "  }",
                  "});",
                  "",
                  "pm.test(\"entries are ordered oldest first\", function () {",
                  "  const history = pm.response.json().history;",
                  "  if (history.length >= 2) {",
                  "    const first = new Date(history[0].timestamp).getTime();",
                  "    const last = new Date(history[history.length - 1].timestamp).getTime();",
                  "    pm.expect(first).to.be.at.most(last);",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{testerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bugs/{{bugId}}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bugs",
                "{{bugId}}",
                "history"
              ]
            }
          },
          "response": []
        },
