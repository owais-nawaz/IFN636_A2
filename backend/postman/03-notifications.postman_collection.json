        {
          "name": "FR-2 | GET my notifications after claim (Tester) → 200",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const res = pm.response.json();",
                  "",
                  "pm.test(\"FR-2: returns 200\", () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test(\"FR-2: lists only tester_sarah's own notifications\", () => {",
                  "  pm.expect(res.success).to.eql(true);",
                  "  res.notifications.forEach(n => pm.expect(n.recipient).to.eql(\"tester_sarah\"));",
                  "});",
                  "",
                  "const bugId = Number(pm.environment.get(\"bugId\"));",
                  "const match = res.notifications.find(n => n.bugId === bugId && n.message.includes(\"claimed by dev_alex\"));",
                  "",
                  "pm.test(\"FR-2: has the 'claimed by dev_alex' notification for BUG-\" + bugId, () => {",
                  "  pm.expect(match, JSON.stringify(res.notifications.map(n => n.message))).to.exist;",
                  "  pm.expect(match.read).to.eql(false);",
                  "});",
                  "",
                  "if (match) pm.environment.set(\"notificationId\", match._id);",
                  "",
                  "pm.test(\"FR-2: unread count is returned\", () => {",
                  "  pm.expect(res.unread).to.be.a(\"number\").and.to.be.at.least(1);",
                  "});",
                  "",
                  "pm.test(\"FR-2: Content-Type is present\", () => {",
                  "  pm.response.to.have.header(\"Content-Type\");",
                  "});",
                  "",
                  "pm.test(\"FR-2: responds within 1000 ms\", () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "});"
                ]
              }
            }
          ],
