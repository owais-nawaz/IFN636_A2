        {
          "name": "NFR-2 | POST writes until rate limited → 429",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.variables.get(\"rlCount\") || 0) + 1;",
                  "pm.variables.set(\"rlCount\", n);"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const n = Number(pm.variables.get(\"rlCount\"));",
                  "const instances = Number(pm.environment.get(\"instances\") || 1);",
                  "const max = 60 * instances + 5;",
                  "",
                  "if (pm.response.code === 401) {",
                  "  // Under the limit: auth rejected it, so the limiter let it through.",
                  "  pm.test(\"NFR-2: write #\" + n + \" is under the limit (401 from auth, not 429)\", () => {",
                  "    pm.response.to.have.status(401);",
                  "  });",
                  "  if (n === 1) {",
                  "    pm.test(\"NFR-2: policy header says 60 per minute\", () => {",
                  "      pm.expect(pm.response.headers.get(\"RateLimit-Policy\")).to.include(\"60-in-1min\");",
                  "    });",
                  "  }",
                  "  if (n < max) pm.execution.setNextRequest(pm.info.requestName);",
                  "  else pm.test(\"NFR-2: limit reached within \" + max + \" writes\", () => pm.expect.fail(\"no 429 after \" + n + \" writes\"));",
                  "} else {",
                  "  pm.variables.set(\"rlCount\", 0);",
                  "  pm.test(\"NFR-2: write #\" + n + \" in this burst returns 429\", () => {",
                  "    pm.response.to.have.status(429);",
                  "  });",
                  "  pm.test(\"NFR-2: 429 body uses the agreed message\", () => {",
                  "    pm.expect(pm.response.json()).to.eql({ success: false, errors: [\"Too many requests, please try again in a minute.\"] });",
                  "  });",
                  "  pm.test(\"NFR-2: no more than 60 writes per instance were allowed\", () => {",
                  "    pm.expect(n - 1).to.be.at.most(60 * instances);",
                  "  });",
                  "  ",
                  "  pm.test(\"NFR-2: Content-Type is present\", () => {",
                  "    pm.response.to.have.header(\"Content-Type\");",
                  "  });",
                  "  ",
                  "  pm.test(\"NFR-2: responds within 1000 ms\", () => {",
                  "    pm.expect(pm.response.responseTime).to.be.below(1000);",
                  "  });",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bugs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bugs"
              ]
            },
            "description": "Rate limit (NFR-2): POST, PATCH and PUT under /api are limited to 60 per minute per client IP. This request repeats itself (no auth, so each write is rejected with 401 but still counted) until the 429 arrives with \"Too many requests, please try again in a minute.\". Earlier writes in the run count toward the 60. Set instances = 2 when running through the ALB, because each instance counts separately. Run this last and wait a minute before the next run.",
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [
            {
              "name": "429: write limit reached",
              "originalRequest": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  }
                ],
                "url": {
