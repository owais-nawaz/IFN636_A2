    {
      "name": "Invalid transitions return 409 (BTS2-12)",
      "item": [
        {
          "name": "Setup: tester reports a bug (Open)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 201', function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test('bug id saved to bugId', function () {",
                  "  const id = pm.response.json().bug.id;",
                  "  pm.expect(id).to.be.a('number');",
                  "  pm.environment.set('bugId', id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{testerToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bugs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "bugs"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Postman 409 check (safe to ignore)\",\n  \"module\": \"Testing\",\n  \"severity\": \"Low\",\n  \"priority\": \"Low\",\n  \"description\": \"Created by the BTS2-13 Postman collection to test invalid moves.\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "409: resolve an Open bug",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 409 Conflict', function () {",
                  "  pm.response.to.have.status(409);",
                  "});",
                  "",
                  "pm.test('error says the move is not allowed', function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.success).to.equal(false);",
                  "  pm.expect(res.errors[0]).to.include(\"Cannot resolve a bug that is Open\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{devToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/bugs/{{bugId}}/resolve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
