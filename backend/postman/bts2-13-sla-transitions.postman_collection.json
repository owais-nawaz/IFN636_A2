    {
      "name": "Audit History (BTS2-6, FR-1)",
      "description": "Requests for GET /api/bugs/:id/history (BTS2-6, FR-1): success (200 with oldest-first order and role access), 401 without token or invalid token, and 404 for unknown or non-numeric IDs.",
      "item": [
        {
          "name": "Setup: create dummy bug for history testing",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"bug created with 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "",
                  "pm.test(\"bug ticketId saved to bugId\", function () {",
                  "  const bug = pm.response.json().bug;",
                  "  const id = bug.ticketId || bug.id;",
                  "  pm.expect(id).to.be.a(\"number\");",
                  "  pm.environment.set(\"bugId\", id);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
