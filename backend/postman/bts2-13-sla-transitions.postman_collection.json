        {
          "name": "SLA run: as QA Lead (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('returns 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('reports how many bugs were checked and escalated', function () {",
                  "  const res = pm.response.json();",
                  "  pm.expect(res.success).to.equal(true);",
                  "  pm.expect(res.checked).to.be.a('number');",
                  "  pm.expect(res.escalated).to.be.an('array');",
                  "});",
                  "",
                  "pm.test('a second run straight away escalates nothing new', function () {",
                  "  pm.sendRequest({ url: pm.environment.get('baseUrl') + '/api/sla/run', method: 'POST',",
                  "    header: { Authorization: 'Bearer ' + pm.environment.get('qaToken') } }, function (err, res) {",
                  "    pm.expect(err).to.equal(null);",
                  "    pm.expect(res.json().escalated).to.have.length(0);",
                  "  });",
                  "});"
                ]
              }
            }
          ],
