{
  "info": {
    "_postman_id": "0b6f3d2e-7c41-4a8e-9d15-13a2b7c5e913",
    "name": "Bug Tracker - SLA and State Transitions (BTS2-13, BTS2-12)",
    "description": "POST /api/sla/run (BTS2-13) and the 409 responses for invalid status moves (BTS2-12, FR-4a). Run the whole collection in order: Auth saves the JWTs into qaToken, devToken and testerToken, and the transitions folder creates its own bug (saved to bugId) and walks it through every state. Requires the backend on {{baseUrl}} with the seeded demo users.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Auth: log in as qa_lead",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('login returns 200', function () {",
                  "  pm.response.to.have.status(200);",
